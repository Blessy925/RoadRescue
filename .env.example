# Copy this file to .env and fill in your email provider's SMTP details to send account OTP codes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password-or-app-password
SMTP_FROM=RoadRescue <your-email@example.com>

# Generate a private random value before starting the server.
HOSPITAL_ADMIN_TOKEN=
# Optional. Defaults to data/roadrescue.sqlite.
ROADRESCUE_DATABASE=
# Optional. OpenStreetMap Nominatim is used when this is not set.
GOOGLE_MAPS_API_KEY=
