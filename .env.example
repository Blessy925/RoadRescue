# Gmail API OAuth credentials required to send account verification codes.
GMAIL_USER=your-email@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Generate a private random value before starting the server.
HOSPITAL_ADMIN_TOKEN=
# Optional. Defaults to data/roadrescue.sqlite.
ROADRESCUE_DATABASE=
# Optional. OpenStreetMap Nominatim is used when this is not set.
GOOGLE_MAPS_API_KEY=
